APP_NAME=AI-Interview-V2
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=mysql+aiomysql://aiiv2:aiiv2_dev_password@127.0.0.1:3307/ai_interview?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://aiiv2:aiiv2_dev_password@127.0.0.1:3307/ai_interview?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6381/0
LANGGRAPH_CHECKPOINTER_BACKEND=redis
LANGGRAPH_CHECKPOINT_TTL_MINUTES=10080

CHROMA_PERSIST_DIR=./chroma_data
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

JWT_SECRET_KEY=<至少32字节的随机密钥>
SECRET_KEY=<独立的至少32字节随机密钥>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_HMAC_SECRET=<独立的至少32字节随机密钥>

EMAIL_DELIVERY_MODE=console
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
